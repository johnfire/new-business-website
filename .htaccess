RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteEngine On 
RewriteCond %{SERVER_PORT} 80 
RewriteRule ^(.*)$ https://christopherrehm.de/$1 [R=301,L]

# AI-agent Markdown copies and llms.txt: declare UTF-8 so umlauts survive.
AddType text/markdown .md
AddCharset UTF-8 .md .txt

# Old-site URL still linked from elsewhere (Search Console 404, 2026-10-23).
RedirectMatch 301 ^/index\.htm$ https://christopherrehm.de/
